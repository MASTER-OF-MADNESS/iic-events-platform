# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL (from: Project Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon/public key (safe to expose in browser)
# (from: Project Settings → API → Project API keys → anon public)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Google OAuth Client ID for Google Sign-In button
# (from: Google Cloud Console → Credentials → OAuth 2.0 Client ID)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── App Configuration ─────────────────────────────────────────────────────────
# Email domain restriction for student Google login
VITE_ALLOWED_EMAIL_DOMAIN=vitstudent.ac.in

# ── App URL (IMPORTANT: differs per Vercel project) ───────────────────────────
# This is used for Google OAuth redirect and QR code certificate verification URLs.
# Set this to the PUBLIC (student) portal URL in BOTH Vercel projects so that
# Google OAuth always redirects back to the student portal after login.
#
# Vercel Project 1 (Public portal):  VITE_APP_URL=https://iic-events.vercel.app
# Vercel Project 2 (Admin portal):   VITE_APP_URL=https://iic-events.vercel.app  ← same value!
VITE_APP_URL=https://your-public-app.vercel.app

# ── Two Vercel Projects Setup ─────────────────────────────────────────────────
# vercel.json       → used by Vercel Project 1 (Public portal)
#   buildCommand:   npm run build:public
#   outputDirectory: dist-public
#
# vercel.admin.json → copy as vercel.json in Vercel Project 2 (Admin portal)
#   buildCommand:   npm run build:admin
#   outputDirectory: dist-admin
#
# Both projects use the SAME Supabase keys above.

# ── Supabase Edge Function Secrets (Set in Supabase Dashboard ONLY) ──────────
# These are NEVER put in the frontend .env — set them in:
# Supabase Dashboard → Project Settings → Edge Functions → Secrets
#
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=eyJ... (auto-available in Edge Functions)
